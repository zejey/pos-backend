# Copy to .env and adjust. Used by docker-compose and local runs.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=*

# Database (PostgreSQL). Set POS_DB_ENGINE=sqlite for a quick local check.
POS_DB_ENGINE=postgres
POSTGRES_DB=pos
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Comma-separated origins for the React frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Tax (VAT-inclusive). Percent rate carved out of sale totals; 0 disables tax.
POS_TAX_RATE=12
POS_TAX_LABEL=VAT

# Receipt number prefix (e.g. a per-store code). Format: {PREFIX}{date}-{id}.
POS_RECEIPT_PREFIX=R
